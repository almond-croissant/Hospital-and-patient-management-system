# PostgreSQL container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=hospital_db

# API server connection (Next.js runs on the host)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-development-password
DB_SSL=false

# Generate a unique random secret of at least 32 bytes for local use.
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
